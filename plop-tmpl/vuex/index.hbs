const state = {
  {{#each setters}}
    {{name}}: '',
  {{/each}}
}

const mutations = {
  {{#each setters}}
    SET_{{mname}}: (state, {{name}})=>{
      state.{{name}} = {{name}}
    },
  {{/each}}
}

const actions = {
  load{{fname}}({ commit }, {{fname}}) {
    return new Promise((resolve, reject) => {
      {{#each setters}}
        commit('SET_{{mname}}',{{../fname}}.{{name}})
      {{/each}}
    })
  },
}

export default {
  namespaced: true,
  state, 
  actions, 
  mutations
}
